# クリニクスのログイン情報（必須）
CLINICS_EMAIL=your-email@example.com
CLINICS_PASSWORD=your-password

# 直来再診の枠時間（pt_ratio で実効時間 = (1-pt_ratio) × MINUTES_PER_PATIENT を計算）
MINUTES_PER_PATIENT=10

# 予約の実診察時間（枠時間ではなく実際の医師診察時間）
MINUTES_RESIN=6
MINUTES_SHINSIN=10

# 直来初診の医師占有時間（予約初診と同じ10分でOK）
MINUTES_SHINSIN_WALKIN=10

# 未受付予約の出席率（キャンセル・遅刻・no-show を考慮）
# 当院の実測キャンセル率 約10% に合わせて 0.9（10%は来ない想定）
ATTENDANCE_RATE=0.9

# 診察中の患者の残り時間見積もり（分）
MINUTES_IN_EXAM_REMAIN=7

# 物療のみ患者の判定閾値（分）。短いほど物療のみと見なす
MIN_DURATION_MINUTES=20
